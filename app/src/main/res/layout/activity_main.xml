<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07080E"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- Top HUD Cards: RAM & GPU/FPS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <!-- RAM Usage Card -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="#121626"
                android:padding="12dp"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RAM USAGE (LIVE)"
                    android:textColor="#9CA3AF"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRamUsage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="68 MB / 512 MB"
                    android:textColor="#10B981"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />

                <ProgressBar
                    android:id="@+id/ramProgressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:progress="35"
                    android:max="100"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- GPU / FPS Card -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="#121626"
                android:padding="12dp"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GPU &amp; DISPLAY"
                    android:textColor="#9CA3AF"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvFpsCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="60 Hz TARGET"
                    android:textColor="#38BDF8"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvGpuBoost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● Hardware Accel ON"
                    android:textColor="#C084FC"
                    android:textSize="10sp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Center Logo & Title -->
        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/ic_launcher"
            android:contentDescription="Vibration Logo"
            android:layout_marginTop="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VIBRATION"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="0.16"
            android:layout_marginTop="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ultra-Performance Virtual Space"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tvEngineStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Virtual Space Ready • 60 FPS Boost"
            android:textColor="#C084FC"
            android:textSize="12sp"
            android:background="#1E1635"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_marginTop="10dp" />

        <!-- 4 REAL ACTION BUTTONS -->

        <!-- 1. ADD EFOOTBALL -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddEfootball"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="ADD eFOOTBALL"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="#151928"
            app:strokeColor="#9333EA"
            app:strokeWidth="2dp"
            app:cornerRadius="14dp"
            android:layout_marginTop="24dp" />

        <!-- 2. LAUNCH VIBRATION -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLaunchVibration"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="⚡ LAUNCH VIBRATION"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#7E22CE"
            app:cornerRadius="14dp"
            android:layout_marginTop="12dp" />

        <!-- 3. GOOGLE PLAY STORE HUB -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPlayStoreHub"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="GOOGLE PLAY STORE HUB ↗"
            android:textColor="#38BDF8"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="#121626"
            app:strokeColor="#38BDF8"
            app:strokeWidth="1dp"
            app:cornerRadius="14dp"
            android:layout_marginTop="12dp" />

        <!-- 4. INSTALL PLAY STORE INSIDE (GBOX) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnInstallPlayStoreInside"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="INSTALL PLAY STORE INSIDE (GBOX)"
            android:textColor="#10B981"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="#0F241E"
            app:strokeColor="#10B981"
            app:strokeWidth="1dp"
            app:cornerRadius="14dp"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</ScrollView>
