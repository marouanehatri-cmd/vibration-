<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="24dp">

    <LinearLayout
        android:id="@+id/telemetryBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvRamBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RAM: 84MB (Target &lt; 150MB)"
            android:textColor="@color/green_neon"
            android:textSize="12sp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp" />

        <Space
            android:layout_width="12dp"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvGpuBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GPU Boost: ON (60 FPS)"
            android:textColor="@color/accent_cyan"
            android:textSize="12sp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/heroSection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/telemetryBar"
        app:layout_constraintBottom_toTopOf="@id/actionsSection"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="Vibration Logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VIBRATION"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:letterSpacing="0.15"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ultra-Lightweight Virtual Space"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvEngineStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● Ready to clone eFootball"
            android:textColor="@color/accent_purple"
            android:textSize="13sp"
            android:layout_marginTop="16dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/actionsSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddApp"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="@string/btn_add_efootball"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:backgroundTint="@color/bg_card"
            app:strokeColor="@color/accent_purple"
            app:strokeWidth="1.5dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLaunch"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="14dp"
            android:text="@string/btn_launch_vibration"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:backgroundTint="@color/accent_purple" />

        <TextView
            android:id="@+id/tvCheckUpdate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:text="Check eFootball Google Play Updates ↗"
            android:textColor="@color/accent_blue"
            android:textSize="13sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
